# ==============================================================================
# FinSight AI — Environment Variables Template
# ==============================================================================

# Required: Google Gemini API Key for financial statement extraction & RAG generation
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Server port (defaults to 8000; cloud platforms like Render set this automatically via $PORT)
PORT=8000
